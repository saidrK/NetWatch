{
    "compilerOptions": {
      // "baseUrl": ".",
      "paths": {
        "@/*": ["./src/*"]
      },
      "jsx": "react-jsx",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "target": "ES2020",
      "allowJs": true,
      "checkJs": false,
      "noEmit": true,
      "isolatedModules": true,
      "skipLibCheck": true
    },
    "include": ["src"]
  }