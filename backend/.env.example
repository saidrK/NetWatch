# ──────────────────────────────────────────────────────────
# CONFIGURATION PROJET NETWATCH — FSBM
# Fichier pour l'environnement de Production (Docker)
# ──────────────────────────────────────────────────────────

# 1. PARAMÈTRES DE L'APPLICATION
PROJECT_NAME="NetWatch API"
API_V1_STR="/api/v1"
DEBUG=False
# Origines autorisées (CORS)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost", "https://votre-domaine.com"]

# 2. BASE DE DONNÉES POSTGRESQL
# Format SQLAlchemy: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://your_user:your_password@your-host:5433/your_database"

# 3. BASE DE DONNÉES INFLUXDB (Métriques Temps Réel)
INFLUXDB_URL="http://your-influxdb-host:8086"
INFLUXDB_TOKEN="your_influxdb_token_here"
INFLUXDB_ORG="your_org"
INFLUXDB_BUCKET="metriques"

# 4. SÉCURITÉ & AUTHENTIFICATION (JWT)
# Générer une clé avec : openssl rand -hex 32
JWT_SECRET="your_long_random_jwt_secret"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_HOURS=12

# 5. ALERTES: TELEGRAM BOT
# Créer le bot via BotFather et récupérer le Token et le Chat ID
TELEGRAM_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# 6. ALERTES: EMAIL SMTP (FallBack)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your.email@example.com"
SMTP_PASSWORD="your_smtp_app_password"

# 7. ALERTES: WEBHOOK (Slack / Discord)
# URL générique pour notifications d'escalade
WEBHOOK_URL="https://example.com/webhook"

# 8. SERVICES EXTERNES
# Timeout global pour les services externes en secondes
EXTERNAL_TIMEOUT=5.0
